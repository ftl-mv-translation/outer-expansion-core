#: src-en/data/text_misc.xml.append:4
msgid ""
"data/text_misc.xml.append$//text[@name=\"ship_PLAYER_SHIP_OE_BROADSIDE_unlock\"]"
msgstr ""
"Des rapports provenant des secteurs les plus proches du Nœud 17 (Secteur 7) "
"indiquent qu'un étrange vaisseau rebelle patrouille dans leur flotte."

#: src-en/data/text_misc.xml.append:5
msgid ""
"data/text_misc.xml.append$//text[@name=\"ship_PLAYER_SHIP_OE_BROADSIDE_2_unlock\"]"
msgstr "Atteindre le secteur 5 avec le Type A pour débloquer ce vaisseau."

#: src-en/data/text_misc.xml.append:6
msgid ""
"data/text_misc.xml.append$//text[@name=\"ship_PLAYER_SHIP_OE_BROADSIDE_3_unlock\"]"
msgstr ""
"Atteindre le secteur 5 avec le Type B ou finir le jeu avec le Type A pour "
"débloquer ce vaisseau."
